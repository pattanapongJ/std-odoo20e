<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_attribute_report_view_pivot" model="ir.ui.view">
        <field name="name">bs.product.attribute.report.pivot</field>
        <field name="model">bs.product.attribute.report</field>
        <field name="arch" type="xml">
            <pivot string="Stock and Sales by Attribute" sample="1">
                <field name="value_id" type="row"/>
                <field name="qty_on_hand" type="measure"/>
                <field name="sales_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- What a pivot cell opens: the rows behind the number. -->
    <record id="product_attribute_report_view_list" model="ir.ui.view">
        <field name="name">bs.product.attribute.report.list</field>
        <field name="model">bs.product.attribute.report</field>
        <field name="arch" type="xml">
            <list string="Stock and Sales by Attribute" create="0" edit="0" delete="0">
                <field name="product_id"/>
                <field name="attribute_id" optional="hide"/>
                <field name="value_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="warehouse_id" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="date" optional="show"/>
                <field name="qty_on_hand" sum="On Hand"/>
                <field name="sales_qty" sum="Qty Sold"/>
            </list>
        </field>
    </record>

    <record id="product_attribute_report_view_graph" model="ir.ui.view">
        <field name="name">bs.product.attribute.report.graph</field>
        <field name="model">bs.product.attribute.report</field>
        <field name="arch" type="xml">
            <graph string="Stock and Sales by Attribute" type="bar" sample="1">
                <field name="value_id"/>
                <field name="qty_on_hand" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="product_attribute_report_view_search" model="ir.ui.view">
        <field name="name">bs.product.attribute.report.search</field>
        <field name="model">bs.product.attribute.report</field>
        <field name="arch" type="xml">
            <search string="Stock and Sales by Attribute">
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="categ_id" filter_domain="[('categ_id', 'child_of', raw_value)]"/>
                <field name="value_id"/>
                <field name="warehouse_id"/>
                <!-- Each keeps the undated stock rows: narrowing the sales
                     period must not hide what is on hand. -->
                <filter string="Sold in the Last 30 Days" name="sold_30"
                        domain="['|', ('date', '=', False), ('date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Sold in the Last 90 Days" name="sold_90"
                        domain="['|', ('date', '=', False), ('date', '&gt;=', (context_today() - relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <filter string="Sold in the Last 12 Months" name="sold_365"
                        domain="['|', ('date', '=', False), ('date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter string="Product Category" name="group_by_categ" context="{'group_by': 'categ_id'}"/>
                    <filter string="Warehouse" name="group_by_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Order Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                </group>
                <!-- One attribute at a time: a variant is a row under each of
                     its attributes, so totals across attributes count it more
                     than once. -->
                <searchpanel view_types="pivot,graph">
                    <field name="attribute_id" string="Attribute" icon="sell"
                           select="one"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_product_attribute_report" model="ir.actions.act_window">
        <field name="name">Stock and Sales by Attribute</field>
        <field name="res_model">bs.product.attribute.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="product_attribute_report_view_search"/>
        <field name="context">{'show_attribute': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock or sales for products with attributes yet</p>
            <p>Pick an attribute on the left. Its values become the rows, measured by
               stock on hand and quantity sold. Totals hold within one attribute.</p>
        </field>
    </record>

    <record id="action_product_attribute_report_open" model="ir.actions.server">
        <field name="name">Stock and Sales by Attribute</field>
        <field name="model_id" ref="model_bs_product_attribute_report"/>
        <!-- Without groups a server action needs write access to its model,
             which a report never grants. -->
        <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_user'), ref('sales_team.group_sale_salesman')])]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="menu_product_attribute_report_stock"
              name="Stock and Sales by Attribute"
              parent="stock.menu_warehouse_report"
              action="action_product_attribute_report_open"
              sequence="120"/>

    <menuitem id="menu_product_attribute_report_sale"
              name="Stock and Sales by Attribute"
              parent="sale.menu_sale_report"
              action="action_product_attribute_report_open"
              sequence="120"/>

</odoo>
