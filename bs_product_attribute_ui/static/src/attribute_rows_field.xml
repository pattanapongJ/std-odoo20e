<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bs_product_attribute_ui.ProductAttributeRows">
        <div class="o_field_product_attribute_rows w-100">
            <div t-foreach="this.attributeRows" t-as="row" t-key="row.id"
                 class="o_attribute_row d-flex align-items-baseline gap-2 mb-1">
                <span class="o_attribute_label text-muted small text-truncate"
                      style="min-width: 8rem;"
                      t-out="row.label"/>
                <span>
                    <span t-foreach="row.values" t-as="value" t-key="value_index"
                          class="o_attribute_value badge rounded-pill text-bg-secondary me-1 fw-normal"
                          t-out="value"/>
                </span>
            </div>
        </div>
    </t>

</templates>
