<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bs_label_profile_view_form" model="ir.ui.view">
        <field name="name">bs.label.profile.form.stock</field>
        <field name="model">bs.label.profile</field>
        <field name="inherit_id" ref="bs_product_label.bs_label_profile_view_form"/>
        <field name="arch" type="xml">
            <field name="show_price" position="before">
                <field name="show_lot"/>
            </field>
        </field>
    </record>

    <menuitem id="menu_bs_label_profile"
              name="Label Profiles"
              parent="stock.menu_product_in_config_stock"
              action="bs_product_label.action_bs_label_profile"
              groups="stock.group_stock_manager"
              sequence="60"/>

</odoo>
