<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Actions > Custom Labels (core already has a "Print Labels"). Bound server actions rather than buttons in
         views: no view inheritance to break, and they work from lists too.
         group_ids: without it a server action needs write access to the
         records, which people printing labels often do not have. -->
    <record id="action_print_labels_product_template" model="ir.actions.server">
        <field name="name">Custom Labels</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form,kanban</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="state">code</field>
        <field name="code">action = env["bs.label.print.wizard"]._action_open(records)</field>
    </record>

    <record id="action_print_labels_product_product" model="ir.actions.server">
        <field name="name">Custom Labels</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form,kanban</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="state">code</field>
        <field name="code">action = env["bs.label.print.wizard"]._action_open(records)</field>
    </record>

</odoo>
