<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_code_preview_view_form" model="ir.ui.view">
        <field name="name">product.code.preview.form</field>
        <field name="model">product.code.preview</field>
        <field name="arch" type="xml">
            <form string="Generate Internal Reference">
                <div class="mb-2">
                    <strong><field name="change_count" class="d-inline"/></strong> will change,
                    <field name="same_count" class="d-inline"/> already up to date,
                    <field name="skip_count" class="d-inline"/> with no rule.
                </div>
                <div class="alert alert-warning py-2" role="alert" invisible="not duplicate_count">
                    <field name="duplicate_count" class="d-inline"/> new reference(s) would
                    duplicate an existing one. Untick them, or add a Running Number to the rule.
                </div>
                <div class="alert alert-warning py-2" role="alert" invisible="not typed_count">
                    <field name="typed_count" class="d-inline"/> product(s) have a reference
                    no code rule built: it was typed or imported. They are left unticked;
                    tick the ones to replace.
                </div>
                <div class="alert alert-warning py-2" role="alert" invisible="not used_count">
                    <field name="used_count" class="d-inline"/> product(s) are already used on
                    a stock move, order or invoice line, so their current reference may be
                    printed or sent. Those whose rule freezes used references are left unticked.
                </div>
                <div class="alert alert-danger py-2" role="alert" invisible="not broken_count">
                    <field name="broken_count" class="d-inline"/> product(s) are left alone:
                    their rule reads a field that no longer exists. Correct the rule first.
                </div>
                <div class="text-muted small mb-2">
                    Only ticked lines are applied. Running numbers are taken when you
                    apply, so they close up over lines you untick.
                </div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0"
                          decoration-muted="state != 'change'"
                          decoration-warning="is_duplicate">
                        <field name="selected" widget="boolean_toggle"
                               readonly="state != 'change'"/>
                        <field name="product_id" readonly="1"/>
                        <field name="current_code" readonly="1"/>
                        <field name="new_code" readonly="1"/>
                        <field name="state" readonly="1"/>
                        <field name="rule_id" readonly="1" optional="hide"/>
                        <field name="is_typed" readonly="1" width="70px"/>
                        <field name="is_used" readonly="1" width="70px"/>
                        <field name="is_duplicate" readonly="1" width="90px"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary" invisible="not change_count"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
