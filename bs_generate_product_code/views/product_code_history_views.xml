<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_code_history_view_list" model="ir.ui.view">
        <field name="name">product.code.history.list</field>
        <field name="model">product.code.history</field>
        <field name="arch" type="xml">
            <list string="Reference History" create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="product_id"/>
                <field name="old_code"/>
                <field name="new_code"/>
                <field name="rule_id"/>
                <field name="create_uid" string="By" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="product_code_history_view_search" model="ir.ui.view">
        <field name="name">product.code.history.search</field>
        <field name="model">product.code.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="old_code"/>
                <field name="new_code"/>
                <field name="rule_id"/>
                <filter name="replaced" string="Replaced a Reference"
                        domain="[('old_code', '!=', False)]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_code_history" model="ir.actions.act_window">
        <field name="name">Reference History</field>
        <field name="res_model">product.code.history</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reference generated yet</p>
            <p>Every internal reference a code rule writes is listed here, with the
               one it replaced.</p>
        </field>
    </record>

    <menuitem id="menu_product_code_history"
              name="Reference History"
              parent="stock.menu_product_in_config_stock"
              action="action_product_code_history"
              sequence="91"/>

</odoo>
